#!/usr/bin/env bash
# mock `pvesh` for PVE template tests.
#
# Supported read-only API paths used by PVE automation:
#   /cluster/nextid
#   /cluster/resources [--type vm]
#   /version
#   /nodes
#   /nodes/<node>/storage/<store>/status
#   /nodes/<node>/qemu/<vmid>/status/current
#   /nodes/<node>/lxc/<ctid>/status/current
# With --output-format json the payload is compact JSON; the pvesh default is
# pretty JSON (3-space indent, "key" : value) like the real CLI.

MOCK_LIB_DIR=$(cd "$(dirname "$0")/../lib" && pwd)
# shellcheck source=/dev/null
. "$MOCK_LIB_DIR/common.sh"

mock_call pvesh "$@"

sub="$1"
[ -n "$sub" ] || mock_usage "pvesh <get|set|...> <path> [options]"
shift

pvesh_parse_args() {
  PVEH_FORMAT="pretty"
  PVEH_TYPE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --output-format) PVEH_FORMAT="${2:-json}"; shift 2 ;;
      --output-format=*) PVEH_FORMAT="${1#--output-format=}"; shift ;;
      --type) PVEH_TYPE="${2:-}"; shift 2 ;;
      --type=*) PVEH_TYPE="${1#--type=}"; shift ;;
      *) shift ;;
    esac
  done
  [ "$PVEH_FORMAT" = "json" ] || PVEH_FORMAT="pretty"
}

is_json() { [ "$PVEH_FORMAT" = "json" ]; }

next_id() {
  local id=100
  while [ -d "$MOCK_STATE/vm/$id" ] || [ -d "$MOCK_STATE/ct/$id" ]; do
    id=$((id + 1))
  done
  printf '%s' "$id"
}

version_payload() {
  if is_json; then
    printf '{"release":"8.2","repoid":"9a4d3bd1","version":"8.2.4","api":{"version":"8.2.4","release":"8.2","repoid":"9a4d3bd1"}}\n'
  else
    printf '{\n'
    printf '   "release" : "8.2",\n'
    printf '   "repoid" : "9a4d3bd1",\n'
    printf '   "version" : "8.2.4",\n'
    printf '   "api" : {\n'
    printf '      "version" : "8.2.4",\n'
    printf '      "release" : "8.2",\n'
    printf '      "repoid" : "9a4d3bd1"\n'
    printf '   }\n'
    printf '}\n'
  fi
}

nodes_payload() {
  local node
  node=$(mock_node)
  if is_json; then
    printf '[{"id":"node/%s","node":"%s","status":"online","type":"node","cpu":0.02,"maxcpu":8,"mem":2147483648,"maxmem":16777216000,"disk":1073741824,"maxdisk":10737418240,"level":"","uptime":86400}]\n' \
      "$(json_escape "$node")" "$(json_escape "$node")"
  else
    printf '[\n'
    printf '   {\n'
    printf '      "id" : "node/%s",\n' "$node"
    printf '      "node" : "%s",\n' "$node"
    printf '      "status" : "online",\n'
    printf '      "type" : "node",\n'
    printf '      "cpu" : 0.02,\n'
    printf '      "maxcpu" : 8,\n'
    printf '      "mem" : 2147483648,\n'
    printf '      "maxmem" : 16777216000,\n'
    printf '      "disk" : 1073741824,\n'
    printf '      "maxdisk" : 10737418240,\n'
    printf '      "level" : "",\n'
    printf '      "uptime" : 86400\n'
    printf '   }\n'
    printf ']\n'
  fi
}

storage_content_json() { # store -> JSON array of content types
  local store="$1" c first=1 item
  c=$(file_get "$MOCK_STATE/storages/$store/content" "iso,vztmpl,backup,images,rootdir")
  printf '['
  old_ifs=$IFS
  IFS=,
  for item in $c; do
    IFS=$old_ifs
    [ -z "$item" ] && continue
    [ "$first" = 1 ] || printf ','
    first=0
    printf '"%s"' "$(json_escape "$item")"
    IFS=,
  done
  IFS=$old_ifs
  printf ']'
}

storage_list_payload() {
  local name type avail used total first=1
  if is_json; then printf '['; else printf '[\n'; fi
  for name in $(mock_storage_names); do
    type=$(mock_storage_attr "$name" type dir)
    total=$(mock_storage_attr "$name" total_kib 0)
    used=$(mock_storage_attr "$name" used_kib 0)
    avail=$((total - used))
    total=$((total * 1024))
    used=$((used * 1024))
    avail=$((avail * 1024))
    if is_json; then
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"storage":"%s","type":"%s","content":%s,"active":1,"enabled":1,"shared":0,"avail":%s,"used":%s,"total":%s}' \
        "$(json_escape "$name")" "$(json_escape "$type")" "$(storage_content_json "$name")" \
        "$avail" "$used" "$total"
    else
      [ "$first" = 1 ] || printf ',\n'
      first=0
      printf '   {\n'
      printf '      "storage" : "%s",\n' "$name"
      printf '      "type" : "%s",\n' "$type"
      printf '      "content" : %s,\n' "$(storage_content_json "$name")"
      printf '      "active" : 1,\n'
      printf '      "enabled" : 1,\n'
      printf '      "shared" : 0,\n'
      printf '      "avail" : %s,\n' "$avail"
      printf '      "used" : %s,\n' "$used"
      printf '      "total" : %s\n' "$total"
      printf '   }'
    fi
  done
  if is_json; then printf ']\n'; else printf '\n]\n'; fi
}

storage_status_payload() { # store
  local store="$1" total used avail
  mock_storage_exists "$store" || mock_fail "storage '$store' does not exist" 255
  total=$(mock_storage_attr "$store" total_kib 0)
  used=$(mock_storage_attr "$store" used_kib 0)
  avail=$((total - used))
  total=$((total * 1024))
  used=$((used * 1024))
  avail=$((avail * 1024))
  if is_json; then
    printf '{"active":1,"avail":%s,"content":"iso,vztmpl,backup,images,rootdir","enabled":1,"shared":0,"total":%s,"type":"%s","used":%s}\n' \
      "$avail" "$total" "$(json_escape "$(mock_storage_attr "$store" type dir)")" "$used"
  else
    printf '{\n'
    printf '   "active" : 1,\n'
    printf '   "avail" : %s,\n' "$avail"
    printf '   "content" : "iso,vztmpl,backup,images,rootdir",\n'
    printf '   "enabled" : 1,\n'
    printf '   "shared" : 0,\n'
    printf '   "total" : %s,\n' "$total"
    printf '   "type" : "%s",\n' "$(mock_storage_attr "$store" type dir)"
    printf '   "used" : %s\n' "$used"
    printf '}\n'
  fi
}

cluster_resources_payload() {
  local first=1 id name status node maxmem maxdisk template uptime type
  node=$(mock_node)
  if is_json; then printf '['; else printf '[\n'; fi
  for id in $(mock_vm_ids); do
    name=$(mock_vm_attr "$id" name "")
    status=$(mock_vm_attr "$id" status stopped)
    maxmem=$(( $(mock_vm_attr "$id" mem 512) * 1048576 ))
    maxdisk=$(mock_vm_attr "$id" bootdisk_bytes 0)
    template=$(mock_vm_attr "$id" template 0)
    [ "$status" = "running" ] && uptime=3600 || uptime=0
    if is_json; then
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"id":"qemu/%s","type":"qemu","vmid":%s,"name":"%s","node":"%s","status":"%s","template":%s,"maxmem":%s,"maxdisk":%s,"uptime":%s}' \
        "$id" "$id" "$(json_escape "$name")" "$(json_escape "$node")" "$status" "$template" "$maxmem" "$maxdisk" "$uptime"
    else
      [ "$first" = 1 ] || printf ',\n'
      first=0
      printf '   {\n'
      printf '      "id" : "qemu/%s",\n' "$id"
      printf '      "type" : "qemu",\n'
      printf '      "vmid" : %s,\n' "$id"
      printf '      "name" : "%s",\n' "$name"
      printf '      "node" : "%s",\n' "$node"
      printf '      "status" : "%s",\n' "$status"
      printf '      "template" : %s,\n' "$template"
      printf '      "maxmem" : %s,\n' "$maxmem"
      printf '      "maxdisk" : %s,\n' "$maxdisk"
      printf '      "uptime" : %s\n' "$uptime"
      printf '   }'
    fi
  done
  for id in $(mock_ct_ids); do
    name=$(mock_ct_attr "$id" name "")
    status=$(mock_ct_attr "$id" status stopped)
    maxmem=$(( $(mock_ct_attr "$id" mem 512) * 1048576 ))
    [ "$status" = "running" ] && uptime=3600 || uptime=0
    if is_json; then
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"id":"lxc/%s","type":"lxc","vmid":%s,"name":"%s","node":"%s","status":"%s","template":0,"maxmem":%s,"maxdisk":0,"uptime":%s}' \
        "$id" "$id" "$(json_escape "$name")" "$(json_escape "$node")" "$status" "$maxmem" "$uptime"
    else
      [ "$first" = 1 ] || printf ',\n'
      first=0
      printf '   {\n'
      printf '      "id" : "lxc/%s",\n' "$id"
      printf '      "type" : "lxc",\n'
      printf '      "vmid" : %s,\n' "$id"
      printf '      "name" : "%s",\n' "$name"
      printf '      "node" : "%s",\n' "$node"
      printf '      "status" : "%s",\n' "$status"
      printf '      "template" : 0,\n'
      printf '      "maxmem" : %s,\n' "$maxmem"
      printf '      "maxdisk" : 0,\n'
      printf '      "uptime" : %s\n' "$uptime"
      printf '   }'
    fi
  done
  if is_json; then printf ']\n'; else printf '\n]\n'; fi
}

guest_status_payload() { # kind id
  local kind="$1" id="$2" status
  if [ "$kind" = "qemu" ]; then
    mock_require_vm "$id"
    status=$(mock_vm_status "$id")
  else
    mock_require_ct "$id"
    status=$(mock_ct_status "$id")
  fi
  if is_json; then
    printf '{"status":"%s"}\n' "$status"
  else
    printf '{\n   "status" : "%s"\n}\n' "$status"
  fi
}

pvesh_get() {
  local path="${1:-}"
  [ -n "$path" ] || mock_usage "pvesh get <path>"
  shift
  pvesh_parse_args "$@"
  local rest node store id kind
  case "$path" in
    /cluster/nextid)
      if is_json; then
        printf '"%s"\n' "$(next_id)"
      else
        next_id
        printf '\n'
      fi
      ;;
    /cluster/resources)
      cluster_resources_payload
      ;;
    /version)
      version_payload
      ;;
    /nodes)
      nodes_payload
      ;;
    /nodes/*/storage)
      storage_list_payload
      ;;
    /nodes/*/storage/*/status)
      rest="${path#/nodes/}"
      node="${rest%%/*}"
      rest="${rest#*/storage/}"
      store="${rest%%/*}"
      storage_status_payload "$store"
      ;;
    /nodes/*/qemu/*/status/current)
      rest="${path#/nodes/}"
      rest="${rest#*/qemu/}"
      id="${rest%%/*}"
      guest_status_payload qemu "$id"
      ;;
    /nodes/*/lxc/*/status/current)
      rest="${path#/nodes/}"
      rest="${rest#*/lxc/}"
      id="${rest%%/*}"
      guest_status_payload lxc "$id"
      ;;
    *) mock_fail "no such resource '$path'" 2 ;;
  esac
}

case "$sub" in
  get) pvesh_get "$@" ;;
  *) mock_fail "mock pvesh only implements 'get' (got '$sub')" 255 ;;
esac
