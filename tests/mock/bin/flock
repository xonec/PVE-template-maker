#!/usr/bin/env bash
# mock `flock` (v2 readiness): accepts fd-lock and file-lock forms, runs the
# wrapped command without creating any real lock.  No-op success is enough
# for serialisation logic that only checks the exit status.

MOCK_LIB_DIR=$(cd "$(dirname "$0")/../lib" && pwd)
# shellcheck source=/dev/null
. "$MOCK_LIB_DIR/common.sh"

mock_call flock "$@"

while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; break ;;
    -w|--timeout|-E|--conflict-exit-code) shift 2 ;;
    -x|-s|-n|-o|-F|--exclusive|--shared|--nonblock|--close|--no-fork) shift ;;
    -*) shift ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || exit 0

# fd-lock form: flock -n 9
case "$1" in
  ''|*[!0-9]*) : ;;
  *) [ $# -eq 1 ] && exit 0 ;;
esac

file="$1"
shift
[ "$file" = "-c" ] && mock_fail "flock: option requires an argument -- 'c'" 1
if [ $# -gt 0 ] && [ "$1" = "-c" ]; then
  shift
  [ $# -gt 0 ] || mock_fail "flock: option requires an argument -- 'c'" 1
  exec bash -c "$1"
fi
[ $# -gt 0 ] || exit 0
exec "$@"
